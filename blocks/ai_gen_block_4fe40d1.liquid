{% doc %}
  @prompt
    mega image section (different image options on desktop and mobile view) with a white btn black font inside the image's bottom centre

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign content_position_desktop = block.settings.content_position_desktop | default: 'middle-center'
  assign content_position_mobile = block.settings.content_position_mobile | default: 'bottom-center'
  assign offset_x_desktop = block.settings.offset_x_desktop | default: 0
  assign offset_y_desktop = block.settings.offset_y_desktop | default: 40
  assign offset_x_mobile = block.settings.offset_x_mobile | default: 0
  assign offset_y_mobile = block.settings.offset_y_mobile | default: 40
  assign has_link = false
  if block.settings.button_link != blank
    assign has_link = true
  endif
-%}

{% style %}
  .ai-mega-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
    display: block;
  }

  .ai-mega-image-link-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-mega-image-link-{{ ai_gen_id }}:focus {
    outline: none;
    box-shadow: none;
  }

  .ai-mega-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-mega-image-desktop-{{ ai_gen_id }},
  .ai-mega-image-mobile-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-mega-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-mega-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-mega-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-mega-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-mega-image-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    color: #000000;
    border: none;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: bold;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  {% if has_link %}
    .ai-mega-image-link-{{ ai_gen_id }}:hover .ai-mega-image-button-{{ ai_gen_id }},
  {% endif %}
  .ai-mega-image-button-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-mega-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    width: 100%;
    max-width: 90%;
    text-align: center;
  }

  .ai-mega-image-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_font_size }}px;
    color: {{ block.settings.header_color }};
    font-weight: 700;
    margin-bottom: 8px;
  }

  .ai-mega-image-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    color: {{ block.settings.subtext_color }};
    font-weight: 400;
    margin-bottom: 16px;
  }

  .ai-mega-image-content-{{ ai_gen_id }} {
    position: absolute;
    z-index: 3;
    width: 100%;
    max-width: 90%;
    pointer-events: none;
    text-align: center;
  }

  {% case content_position_desktop %}
    {% when 'top-left' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 0;
        left: 0;
        transform: translate({{ offset_x_desktop }}px, {{ offset_y_desktop }}px);
        text-align: left;
      }
    {% when 'top-center' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 0;
        left: 50%;
        transform: translate(calc(-50% + {{ offset_x_desktop }}px), {{ offset_y_desktop }}px);
      }
    {% when 'top-right' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 0;
        right: 0;
        transform: translate(-{{ offset_x_desktop }}px, {{ offset_y_desktop }}px);
        text-align: right;
      }
    {% when 'middle-left' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 50%;
        left: 0;
        transform: translate({{ offset_x_desktop }}px, calc(-50% + {{ offset_y_desktop }}px));
        text-align: left;
      }
    {% when 'middle-center' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 50%;
        left: 50%;
        transform: translate(calc(-50% + {{ offset_x_desktop }}px), calc(-50% + {{ offset_y_desktop }}px));
      }
    {% when 'middle-right' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        top: 50%;
        right: 0;
        transform: translate(-{{ offset_x_desktop }}px, calc(-50% + {{ offset_y_desktop }}px));
        text-align: right;
      }
    {% when 'bottom-left' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        bottom: 0;
        left: 0;
        transform: translate({{ offset_x_desktop }}px, -{{ offset_y_desktop }}px);
        text-align: left;
      }
    {% when 'bottom-center' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        bottom: 0;
        left: 50%;
        transform: translate(calc(-50% + {{ offset_x_desktop }}px), -{{ offset_y_desktop }}px);
      }
    {% when 'bottom-right' %}
      .ai-mega-image-overlay-{{ ai_gen_id }},
      .ai-mega-image-content-{{ ai_gen_id }} {
        bottom: 0;
        right: 0;
        transform: translate(-{{ offset_x_desktop }}px, -{{ offset_y_desktop }}px);
        text-align: right;
      }
  {% endcase %}

  @media screen and (max-width: 749px) {
    .ai-mega-image-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-mega-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-mega-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-mega-image-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-mega-image-header-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
    }

    .ai-mega-image-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_font_size | times: 0.9 }}px;
    }

    {% case content_position_mobile %}
      {% when 'top-left' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 0;
          left: 0;
          right: auto;
          bottom: auto;
          transform: translate({{ offset_x_mobile }}px, {{ offset_y_mobile }}px);
          text-align: left;
        }
      {% when 'top-center' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 0;
          left: 50%;
          right: auto;
          bottom: auto;
          transform: translate(calc(-50% + {{ offset_x_mobile }}px), {{ offset_y_mobile }}px);
          text-align: center;
        }
      {% when 'top-right' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 0;
          right: 0;
          left: auto;
          bottom: auto;
          transform: translate(-{{ offset_x_mobile }}px, {{ offset_y_mobile }}px);
          text-align: right;
        }
      {% when 'middle-left' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 50%;
          left: 0;
          right: auto;
          bottom: auto;
          transform: translate({{ offset_x_mobile }}px, calc(-50% + {{ offset_y_mobile }}px));
          text-align: left;
        }
      {% when 'middle-center' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 50%;
          left: 50%;
          right: auto;
          bottom: auto;
          transform: translate(calc(-50% + {{ offset_x_mobile }}px), calc(-50% + {{ offset_y_mobile }}px));
          text-align: center;
        }
      {% when 'middle-right' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          top: 50%;
          right: 0;
          left: auto;
          bottom: auto;
          transform: translate(-{{ offset_x_mobile }}px, calc(-50% + {{ offset_y_mobile }}px));
          text-align: right;
        }
      {% when 'bottom-left' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          bottom: 0;
          left: 0;
          right: auto;
          top: auto;
          transform: translate({{ offset_x_mobile }}px, -{{ offset_y_mobile }}px);
          text-align: left;
        }
      {% when 'bottom-center' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          bottom: 0;
          left: 50%;
          right: auto;
          top: auto;
          transform: translate(calc(-50% + {{ offset_x_mobile }}px), -{{ offset_y_mobile }}px);
          text-align: center;
        }
      {% when 'bottom-right' %}
        .ai-mega-image-overlay-{{ ai_gen_id }},
        .ai-mega-image-content-{{ ai_gen_id }} {
          bottom: 0;
          right: 0;
          left: auto;
          top: auto;
          transform: translate(-{{ offset_x_mobile }}px, -{{ offset_y_mobile }}px);
          text-align: right;
        }
    {% endcase %}
  }
{% endstyle %}

<div
  class="ai-mega-image-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if has_link %}
    <a
      href="{{ block.settings.button_link }}"
      class="ai-mega-image-link-{{ ai_gen_id }}"
      aria-label="{% if block.settings.header_text != blank %}{{ block.settings.header_text | escape }}{% else %}{{ block.settings.button_text | default: 'Open link' | escape }}{% endif %}"
    >
  {% endif %}
      <div class="ai-mega-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.desktop_image or block.settings.mobile_image %}
          {% if block.settings.desktop_image %}
            <img
              src="{{ block.settings.desktop_image | image_url: width: 3840 }}"
              alt="{{ block.settings.desktop_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.desktop_image.width }}"
              height="{{ block.settings.desktop_image.height }}"
              class="ai-mega-image-desktop-{{ ai_gen_id }}"
              sizes="100vw"
              widths="500,1000,1500,2000,3000,3840"
            >
          {% endif %}

          {% if block.settings.mobile_image %}
            <img
              src="{{ block.settings.mobile_image | image_url: width: 2000 }}"
              alt="{{ block.settings.mobile_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.mobile_image.width }}"
              height="{{ block.settings.mobile_image.height }}"
              class="ai-mega-image-mobile-{{ ai_gen_id }}"
              sizes="100vw"
              widths="500,750,1000,1500,2000"
            >
          {% else %}
            {% if block.settings.desktop_image %}
              <img
                src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
                alt="{{ block.settings.desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
                class="ai-mega-image-mobile-{{ ai_gen_id }}"
                sizes="100vw"
                widths="500,750,1000,1500,2000"
              >
            {% endif %}
          {% endif %}
        {% else %}
          <div class="ai-mega-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-mega-image-empty-state-{{ ai_gen_id }}">
              Add desktop and mobile images to get started
            </div>
          </div>
        {% endif %}

        {% if block.settings.header_text != blank or block.settings.subtext_text != blank %}
          <div class="ai-mega-image-overlay-{{ ai_gen_id }}">
            {% if block.settings.header_text != blank %}
              <div class="ai-mega-image-header-{{ ai_gen_id }}">{{ block.settings.header_text }}</div>
            {% endif %}
            {% if block.settings.subtext_text != blank %}
              <div class="ai-mega-image-subtext-{{ ai_gen_id }}">{{ block.settings.subtext_text }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <div class="ai-mega-image-content-{{ ai_gen_id }}">
            {% if has_link %}
              <span class="ai-mega-image-button-{{ ai_gen_id }}" role="presentation">
                {{ block.settings.button_text }}
              </span>
            {% else %}
              <button type="button" class="ai-mega-image-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
  {% if has_link %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Mega image",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 700,
      "step": 25,
      "unit": "px",
      "label": "Mobile height",
      "default": 500
    },
    {
      "type": "select",
      "id": "content_position_desktop",
      "label": "Content position (desktop)",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position (mobile)",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "range",
      "id": "offset_x_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Horizontal offset (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "offset_y_desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Vertical offset (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "offset_x_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Horizontal offset (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "offset_y_mobile",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Vertical offset (mobile)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Button & link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button / Block link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Button vertical padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Button horizontal padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Overlay text"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header text",
      "default": "FEEL THE FREEDOM"
    },
    {
      "type": "text",
      "id": "subtext_text",
      "label": "Subtext",
      "default": "Shop Linea Collections"
    },
    {
      "type": "range",
      "id": "header_font_size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Header font size",
      "default": 36
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Header color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "subtext_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Subtext font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Mega image"
    }
  ],
  "tag": null
}
{% endschema %}
