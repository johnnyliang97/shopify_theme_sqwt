{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                data-href="{{ link.url }}"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="page-width mega-menu__inner">
                  {%- liquid
                    assign link_index = forloop.index
                    assign has_promos = false
                    assign has_child_promos = false
                    assign has_tiles = false

                    for block in section.blocks
                      assign block_type = block.type
                      assign match_parent = false

                      if block_type == 'mega_promo' or block_type == 'mega_child_promo'
                        assign bi = block.settings.parent_index | plus: 0
                        if bi > 0 and bi == link_index
                          assign match_parent = true
                        elsif block.settings.parent_link != blank
                          assign block_url = block.settings.parent_link | strip
                          if block_url != blank and block_url == link.url
                            assign match_parent = true
                          endif
                        endif
                        unless match_parent
                          if block.settings.parent != blank
                            assign block_parent_key = block.settings.parent | strip | downcase
                            assign link_key = link.title | strip | downcase
                            if block_parent_key == link_key
                              assign match_parent = true
                            endif
                          endif
                        endunless

                        if match_parent
                          if block_type == 'mega_promo'
                            assign has_promos = true
                          elsif block_type == 'mega_child_promo'
                            assign has_child_promos = true
                          endif
                        endif
                      endif
                    endfor

                    if has_child_promos or link.links != blank
                      assign has_tiles = true
                    endif
                  -%}

                  {%- if has_tiles -%}
                    <div class="mega-menu__tiles mega-menu__tiles--full">
                      {%- for childlink in link.links -%}
                        {%- liquid
                          assign child_index = forloop.index
                          assign child_tile = null
                          assign child_image = null
                          assign child_title = null
                          assign child_subtitle = null
                          assign child_obj = null

                          for block in section.blocks
                            if block.type == 'mega_child_promo'
                              assign match_parent = false
                              assign match_child = false

                              assign bi = block.settings.parent_index | plus: 0
                              if bi > 0 and bi == link_index
                                assign match_parent = true
                              elsif block.settings.parent_link != blank
                                assign block_url = block.settings.parent_link | strip
                                if block_url != blank and block_url == link.url
                                  assign match_parent = true
                                endif
                              endif
                              unless match_parent
                                if block.settings.parent != blank
                                  assign block_parent_key = block.settings.parent | strip | downcase
                                  assign link_key = link.title | strip | downcase
                                  if block_parent_key == link_key
                                    assign match_parent = true
                                  endif
                                endif
                              endunless

                              if match_parent
                                assign ci = block.settings.child_index | plus: 0
                                if ci > 0 and ci == child_index
                                  assign match_child = true
                                elsif block.settings.child_link != blank
                                  assign block_child_url = block.settings.child_link | strip
                                  if block_child_url != blank and block_child_url == childlink.url
                                    assign match_child = true
                                  endif
                                endif
                                unless match_child
                                  if block.settings.child != blank
                                    assign block_child_key = block.settings.child | strip | downcase
                                    assign child_key = childlink.title | strip | downcase
                                    if block_child_key == child_key
                                      assign match_child = true
                                    endif
                                  endif
                                endunless
                              endif

                              if match_parent and match_child
                                assign child_tile = block
                              endif
                            endif
                          endfor

                          if child_tile != null and child_tile.settings.image != blank
                            assign child_image = child_tile.settings.image
                          endif

                          if childlink.type == 'collection_link' and collections[childlink.object] != blank
                            assign child_obj = collections[childlink.object]
                            if child_image == blank and child_obj.image != blank
                              assign child_image = child_obj.image
                            endif
                          endif

                          if child_tile != null and child_tile.settings.title != blank
                            assign child_title = child_tile.settings.title
                          else
                            assign child_title = childlink.title
                          endif

                          if child_tile != null and child_tile.settings.subtitle != blank
                            assign child_subtitle = child_tile.settings.subtitle
                          endif
                        -%}
                        <a href="{{ childlink.url }}" class="mega-menu__tile">
                          <div class="mega-menu__tile-media">
                            {%- if child_image != blank -%}
                              {{ child_image | image_url: width: 600 | image_tag: class: 'mega-menu__tile-image', loading: 'lazy', widths: '300,450,600,900', alt: child_title | escape }}
                            {%- else -%}
                              <div class="mega-menu__tile-placeholder"></div>
                            {%- endif -%}
                          </div>
                          <div class="mega-menu__tile-title">{{ child_title | escape }}</div>
                          {%- if child_subtitle != blank -%}
                            <div class="mega-menu__tile-subtitle">{{ child_subtitle | escape }}</div>
                          {%- endif -%}
                        </a>
                      {%- endfor -%}
                    </div>
                  {%- elsif has_promos -%}
                    <div class="mega-menu__promo mega-menu__promo--full">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'mega_promo' -%}
                          {%- liquid
                            assign match_parent = false
                            assign bi = block.settings.parent_index | plus: 0
                            if bi > 0 and bi == link_index
                              assign match_parent = true
                            elsif block.settings.parent_link != blank
                              assign block_url = block.settings.parent_link | strip
                              if block_url != blank and block_url == link.url
                                assign match_parent = true
                              endif
                            endif
                            unless match_parent
                              if block.settings.parent != blank
                                assign block_parent_key = block.settings.parent | strip | downcase
                                assign link_key = link.title | strip | downcase
                                if block_parent_key == link_key
                                  assign match_parent = true
                                endif
                              endif
                            endunless
                          -%}
                          {%- if match_parent -%}
                            {%- if block.settings.link != blank -%}
                              <a href="{{ block.settings.link }}" class="mega-menu__promo-item">
                            {%- else -%}
                              <div class="mega-menu__promo-item">
                            {%- endif -%}
                            {%- if block.settings.image != blank -%}
                              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'mega-menu__promo-image', loading: 'lazy', widths: '400,800,1200', alt: block.settings.title | escape }}
                            {%- endif -%}
                            {%- if block.settings.title != blank -%}
                              <div class="mega-menu__promo-title">{{ block.settings.title | escape }}</div>
                            {%- endif -%}
                            {%- if block.settings.link != blank -%}
                              </a>
                            {%- else -%}
                              </div>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
